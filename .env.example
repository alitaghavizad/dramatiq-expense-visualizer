# Local Docker PostgreSQL defaults (development only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=expense_visualizer
POSTGRES_HOST=localhost
DOCKER_POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432

# Optional advanced override. When set, DATABASE_URL takes precedence over the
# five POSTGRES_* values above.
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/expense_visualizer

# Required for Armenian receipt image extraction
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Local app ports/origin
API_PORT=3001
API_HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_EXPENSE_API_URL=http://localhost:3001
WEB_PORT=3000
