# Local Docker PostgreSQL defaults (development only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expense_visualizer
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_visualizer

# Required for Armenian receipt image extraction
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Local app ports/origin
API_PORT=3001
API_HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_EXPENSE_API_URL=http://localhost:3001
