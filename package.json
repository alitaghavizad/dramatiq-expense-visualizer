{
  "name": "dramatiq-expense-visualizer",
  "version": "0.1.0",
  "description": "A local-first Armenian receipt scanner and PostgreSQL expense dashboard powered by Gemini.",
  "private": true,
  "keywords": [
    "armenian",
    "expense-tracker",
    "gemini",
    "postgresql",
    "receipt-ocr"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:api": "tsc -p tsconfig.server.json",
    "start": "concurrently -k -n web,api -c cyan,green \"npm:start:web\" \"npm:start:api\"",
    "start:web": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:api": "node server-dist/server/index.js",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern server-dist",
    "audit": "npm audit --audit-level=high",
    "check": "npm run lint && npm test && npm run build && npm run audit",
    "db:init": "tsx server/init-db.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "lucide-react": "^1.32.0",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.0",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "^0.5.34",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "^1.0.0-beta.6",
    "vite": "^8.2.1",
    "wrangler": "^4.124.0"
  },
  "type": "module"
}
